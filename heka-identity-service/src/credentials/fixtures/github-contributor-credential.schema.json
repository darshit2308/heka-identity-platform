{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GithubContributorCredentialSubject",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^did:hedera:.*"
    },
    "githubUsername": {
      "type": "string",
      "minLength": 1
    },
    "githubAccountId": {
      "type": "integer",
      "minimum": 1
    },
    "gpgFingerprint": {
      "type": "string",
      "pattern": "^[0-9A-F]{16,40}$"
    }
  }, 
  "required": ["id", "githubUsername", "githubAccountId", "gpgFingerprint"],
  "additionalProperties": false
}